# Database URL (PostgreSQL or local SQLite fallback)
# For PostgreSQL: postgresql+psycopg://username:password@localhost:5432/ai_business_db
# For SQLite (default out of the box): sqlite:///./ai_business_agent.db
DATABASE_URL=sqlite:///./ai_business_agent.db

# Google Gemini API Key
GEMINI_API_KEY=

# JWT Secret Key
JWT_SECRET=super-secret-key-ai-business-operations-agent-2026-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# App Settings
APP_NAME=AI Business Operations Agent
ENVIRONMENT=development
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# SMTP Configuration
SMTP_SERVER=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=user@example.com
SMTP_PASSWORD=your_password
SMTP_FROM_EMAIL=user@example.com
