# Database URL
# Supabase: copy the Session Pooler connection string from
# Project Settings -> Database -> Connection string and use the psycopg driver.
# Example: postgresql+psycopg://postgres.project-ref:password@pooler-host:5432/postgres
DATABASE_URL=sqlite:///./ai_business_agent.db
ALLOW_SQLITE_FALLBACK=true

# Supabase project settings (used by storage/auth integrations)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
# Keep this secret. Never expose it to the React frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API Key
GEMINI_API_KEY=

# JWT Secret Key
JWT_SECRET=super-secret-key-ai-business-operations-agent-2026-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# App Settings
APP_NAME=AI Business Operations Agent
ENVIRONMENT=development
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# SMTP Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=def72630@gmail.com
SMTP_PASSWORD=hsawovmrquuyoucq
SMTP_FROM_EMAIL=def72630@gmail.com

# Google OAuth 2.0 Configuration (OpenID Connect)
# Development Redirect URI: http://localhost:8000/api/auth/google/callback
# Production Redirect URI: https://<your-backend-render-app>.onrender.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173
